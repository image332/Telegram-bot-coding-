# Copy to your shell or hosting dashboard. The bot does NOT read this file automatically;
# on Render, enter these in the Environment tab. Never commit a filled-in .env.

# REQUIRED — bot token from @BotFather (the ONLY variable used for the token)
TELEGRAM_BOT_TOKEN=

# REQUIRED — numeric Telegram user IDs of admins, comma-separated
ADMIN_IDS=

# Optional — HTTP port for the health endpoint (Render sets this automatically)
PORT=10000

# Optional — path to cookies.txt (default: ./cookies.txt). Used for YouTube only.
COOKIES_PATH=

# Optional — temporary download folder (default: ./downloads)
DOWNLOAD_DIR=

# Optional — SQLite database file (default: ./bot.db). Not persistent on Render Free.
DB_PATH=

# Optional — Telegram upload limit for bots, in MB (default: 50)
MAX_UPLOAD_MB=50

# Optional — simultaneous downloads (default: 2)
MAX_CONCURRENT_DOWNLOADS=2

# Optional — explicit tool paths. Leave empty to auto-detect on PATH.
FFMPEG_PATH=
DENO_PATH=

# Optional — extra yt-dlp YouTube arguments you supply (e.g. a PO token). See YOUTUBE_SETUP.md.
YT_EXTRACTOR_ARGS=
